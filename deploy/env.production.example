# Production .env for /opt/schoolify/backend/.env (never commit the real one).
# Generate secrets with: openssl rand -base64 32

TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
APP_KEY=
APP_URL=https://schoolify.twelveai.app
FRONTEND_URL=https://schoolify.twelveai.app
CORS_ORIGIN=https://schoolify.twelveai.app
SESSION_DRIVER=cookie

# Postgres (container; values also create the database on first boot)
DB_HOST=postgres
DB_PORT=5432
DB_USER=schoolify
DB_PASSWORD=
DB_DATABASE=schoolify

# Redis (container)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail (Gmail SMTP shared with payAI; from address must be the Gmail account)
MAIL_MAILER=smtp
MAIL_FROM_NAME=Schoolify
MAIL_FROM_ADDRESS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=

# Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=medium

# Optional: payments (payment.twelveai.app) and WhatsApp (Meta Cloud API)
# PAYMENT_BASE_URL= PAYMENT_SECRET_KEY= PAYMENT_PUBLIC_KEY= PAYMENT_WEBHOOK_SECRET=
# WHATSAPP_TOKEN= WHATSAPP_PHONE_NUMBER_ID= WHATSAPP_VERIFY_TOKEN= WHATSAPP_APP_SECRET= WHATSAPP_DISPLAY_NUMBER=

# Ports the stack binds on 127.0.0.1 (host nginx proxies to these)
API_PORT=4200
WEB_PORT=4201
FRONTEND_DIR=../frontend
